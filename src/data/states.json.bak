        "dance_forms": {
          "folk": [
            {
              "id": "51356ba5",
              "name": "Lambadi",
              "desc": "The Lambadi folk dance, deeply rooted in the cultural heritage of the Lambadi community, carries a fascinating history that spans centuries. This dance form originated from the nomadic lifestyle of the Lambadi people, who have their ancestral roots in Rajasthan, Gujarat, and parts of Andhra Pradesh and Telangana in India. The Lambadi community, historically known as the Banjaras or Gypsies, led a migratory existence, traveling long distances in search of livelihood and trading opportunities. During their journeys, they developed Lambadi folk dance as a means of communication, entertainment, and preserving their cultural traditions.",
              "img": "/downloaded_images/f5c4baba0036261511aeec117e519a4f.webp",
              "artists": ""
            }
          ],
          "classical": []
        }
      },
      "monuments": [
        {
          "id": "suvt9dhhp",
          "title": "Andhra Pradesh- Monument- Buddhist Architecture - Nagarjunakonda",
          "name": "Andhra Pradesh- Monument- Buddhist Architecture - Nagarjunakonda",
          "desc": "Nagarjunakonda is named after Nagarjuna, a Buddhist monk, who lived here around the turn of the 2nd century AD. A magnificent example of ancient Buddhist architecture the original valley was shifted, as it was at the danger of being submerged under the Nagarjuna Sagar Dam. The valley symbolizes a lost civilization, which flourished thousand years ago. A number of excavations were carried out here, which revealed many Chaityas and Viharas. Buddha statues, relics, stone images, Jataka tales encrypted panels and other items of Buddhist origin were also unearthed during excavations. It is believed that the antique sculptures belong to the Ikshvaku rule. The ruins of a university have also been found at Nagarjunakonda.",
          "img": "/state-images/Andhra_Pradesh/Nagarjunakonda1.webp",
          "historical_significance": "Ancient 001-600 CE",
          "materials": "",
          "lat": 16.5223922,
          "lon": 79.2416262
        },
        {
          "id": "2j13e128g",
          "title": "Andhra Pradesh- Monument- Buddhist Architecture - Sankaram",
          "name": "Andhra Pradesh- Monument- Buddhist Architecture - Sankaram",
          "desc": "One of the most important Buddhist sites in Andhra Pradesh, Sankaram is known for its third and fourth century Buddhist structures. The name Sankaram derives from the term Sangharama. Sankaram is famous for the whole lot of stupas, rock-cut caves, brick-built structural edifices, early historic pottery and Satavahana coins that date back to the 1st century CE. The main stupa here was initially carved out of rock and then covered with bricks. Excavations have revealed several antiquities like seals, inscribed tablets, pots, copper coins mostly of seventh century CE.",
          "img": "/state-images/Andhra_Pradesh/sankaram.webp",
          "historical_significance": "Early Medieval 1500-1550",
          "materials": "",
          "lat": 17.9367549,
          "lon": 82.7364602
        },
        {
          "id": "559bzqkfo",
          "title": "Thousand Pillar Temple",
          "name": "Thousand Pillar Temple",
          "desc": "One of the most famous monuments of Andhra Pradesh, the Thousand Pillar Temple, is a twelfth century temple located in Hanamkonda, which was built in 1163 CE by the Kakatiya King Rudra Deva, following the Chalukyan style of temple architecture. The star shaped, triple-shrined temple built on one metre high platform is dedicated to Lord Shiva (Rudreswara), Lord Vishnu (Vasudeva) and Surya . The temple is famous for its richly carved pillars, screens and detailed sculptures, perforated stone screens, richly carved icons, meticulously designed pillars. It has a majestic monolithic Nandi in a highly polished black basalt stone and the 1000-pillared hall architecture.",
          "img": "/state-images/Andhra_Pradesh/warangal-thousand-pillar-1.webp",
          "historical_significance": "Early Medieval 750-1200",
          "materials": "",
          "lat": 15.188516819751438,
          "lon": 79.51983013691046
        },
        {
          "id": "h0twuo93b",
          "title": "Golconda fort",
          "name": "Golconda fort",
          "desc": "is one of the famous forts of India. The name originates from the Telugu words Golla Konda meaning Shepherd\u0092s Hill. The origins of the fort can be traced back to the Yadava dynasty of Deogiri and the Kakatiyas of Warangal. Originally a mud fort, it was passed on to the Bahmani dynasty and later to the Qutub Shahis, who held it from 1518 to 1687 CE. The first three Qutb Shahi kings rebuilt Golconda, over a span of 62 years. The fort also has the cannons used in the last siege of Golconda by Aurangzeb, to whom the fort ultimately fell. The huge gates of the fort are decorated with large pointed iron spikes. These spikes prevented elephants from damaging the fort. The fort of Golconda is encircled by a 11-km long outer wall. This was build in order to fortify the fort.",
          "img": "/state-images/Andhra_Pradesh/golconda-fort.webp",
          "historical_significance": "Ancient 750-1200",
          "materials": "",
          "lat": 15.834966654788143,
          "lon": 80.43344757815257
        },
        {
          "id": "ffmhlyrmt",
          "title": "Andhra Pradesh- Monument- Qutub Shahi Tombs",
          "name": "Andhra Pradesh- Monument- Qutub Shahi Tombs",
          "desc": "The tombs of the legendary Qutub Shahi kings lie to the north of Golconda, about a kilometre away from Banjara Darwaza of the Golconda Fort. Planned and built by the Qutb Shahis themselves, these tombs are said to be the oldest historical monuments in Hyderabad. They form a large group of tombs and stand on a raised platform. The tombs are built in Persian and Hindu architectural styles using grey granite, with stucco ornamentation, the only one of its kind in the world where an entire dynasty has been buried at one place.",
          "img": "/state-images/Andhra_Pradesh/qutb-shahi-1.webp",
          "historical_significance": "Medieval 1600-1650",
          "materials": "",
          "lat": 16.351976834993565,
          "lon": 79.63945727811277
        },
