        "dance_forms": {
          "folk": [
            {
              "id": "40e30cc8",
              "name": "Dekhni",
              "desc": "Originally a dance of fisherfolk & women during festivals. The Dekhni dance is a vibrant and graceful traditional Goan dance, often performed during religious and cultural celebrations. It is particularly popular in Goa's Hindu communities and is characterized by its fluid, expressive movements. The dance is usually accompanied by devotional songs sung in Konkani, and the lyrics often revolve around themes of love, devotion, and celebration. Dekhni is typically performed by women, and the dancers wear colourful, traditional attire, including elaborate jewellery. The dance involves intricate footwork and hand gestures, showcasing the elegance of the performer. It is usually performed to rhythmic beats played on traditional Goan instruments, such as the dholak and harmonium. The Dekhni is often seen at festivals, temple events, and during celebrations like the Shigmo festival. Its graceful, storytelling nature makes it an important part of Goa's cultural heritage.",
              "img": "/downloaded_images/948958ba2e0ddb048723a316e1c57a5a.webp",
              "artists": ""
            }
          ],
          "classical": []
        }
