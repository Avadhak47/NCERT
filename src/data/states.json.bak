        "performing_arts": [
          {
            "id": "qgjfjpvr8",
            "title": "Punjab- Performing Art- Dance- Bhangra",
            "name": "Punjab- Performing Art- Dance- Bhangra",
            "desc": "The Punjab\u0092s famous dances, Bhangra and Giddha are inextricably linked with this festival. Bhangra is a lively form of music and dance. People traditionally perform Bhangra when celebrating the harvest. This dance is performed on Baisakhi when harvesting is over and fairs are held. During Bhangra, people sing Punjabi Boliyaan - lyrics, at least one person plays the the dhol drum, and other people may play the flute, dholak, or other musical instruments. While Bhangra began as a part of harvest festival celebrations, it eventually became a part of such diverse occasions as weddings and New Year celebrations.",
            "img": "/state-images/Punjab/Bhangra.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "1aeqny38l",
            "title": "Punjab- Performing Art- Dance- Kikli",
            "name": "Punjab- Performing Art- Dance- Kikli",
            "desc": "Kikli is generally popular with the younger girls. They form pairs and then the two girls of each pair stand opposite each other holding each other\u0092s hands crosswise. Then they lift their heels and swing round and round on their toes.",
            "img": "/state-images/Punjab/kikli.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
