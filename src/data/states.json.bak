        "performing_arts": [
          {
            "id": "o9asbod27",
            "title": "Andhra Pradesh- Performing Art- Dance- Kuchipudi",
            "name": "Andhra Pradesh- Performing Art- Dance- Kuchipudi",
            "desc": "Kuchipudi, a blend of music and abhinaya, is Andhra Pradesh\u0091s unique contribution to dance which originated from a village called Kuchelapuri or Kuchelapuram in Krishna district around 300 B. C., Since then it has remained a living Brahmin community. The dance style is based on the standard treatises, viz. Abhinaya Darpana and Bharatarnava of Nandikeshwara, which is sub-divided into Nattuva Mala and Natya Mala. A Kuchipudi dancer has to be well versed in dancing, acting, music, various languages and texts. Some of the celebrated performers and gurus were Kuchipudi Brahmins like Lakshmi Narayan Shastri, Chinta Krishna Murti and Vedantam Chinna Satyam.",
            "img": "/state-images/Andhra_Pradesh/Kuchipudi-Dance.webp",
            "historical_significance": "Modern 1947-1980",
            "materials": ""
          },
          {
            "id": "60z6uicha",
            "title": "Andhra Pradesh- Performing Art- Dance- Veeraanatyam",
            "name": "Andhra Pradesh- Performing Art- Dance- Veeraanatyam",
            "desc": "This dance form is performed by the Veeramusti community of Andhra Pradesh which claims to be the descendant of Veerabhadra. This is a vigorous dance form performed with instruments like tambura, soolam, dolu, tasha and veeranam. This community is usually found at Draksharamam in East Godavari District. It is believed that Lord Shiva, performed an aggressive dance, outraged at the humiliation of his consort. He plucked a strand out of his long hair and created the legendary Veerabhadra.",
            "img": "https://www.southtourism.in/assets/images/destination/andhra/arts/veeranatyam.webp",
            "historical_significance": "Modern 1947-1980",
            "materials": ""
          },
