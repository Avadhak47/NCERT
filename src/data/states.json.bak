      "single_gestures": "1. Pataka\n2. Tripataka\n3. Ardhapataka\n4. Kartarimukha\n5. Mayura\n6. Ardhachandra\n7. Arala\n8. Sukhatunda\n9. Mushti\n10. Shikhara\n11. Kapitha\n12. Katakamukha\n13. Suchi \n14. Chandrakala\n15. Padmakosha \n16. Sarpasirsha\n17. Mrigasirsha\n18. Simhamukham\n 19. Kangula \n20. Allapadma\n 21. Chatura\n22. Bhramara\n23. Hamsasya\n24. Hamsapaksha\n 25. Samdamsha\n26. Mukula\n27. Tamrachuda\n28. Trishula",
      "single_gestures_images": [],
      "joint_gestures": "1. Anjali\n2. Kapota\n3. Karkata\n4. Swastika\n5. Dola\n6. Puspaputa\n7. Utsanga\n8. Shivlinga\n9. Katakavardana\n10. Kartariswastika\n11. Shakata\n12. Shanka\n13. Chakra\n14. Samputa\n15. Pasha\n16. Keelaka\n17. Matsya\n18. Kurma\n19. Varaha\n20. Garuda\n21.Nagabandha\n22. Khatwa\n23. Berunda\n24. Avahitta",
      "joint_gestures_images": [
