        "handicrafts": [
          {
            "id": "qd0m1816o",
            "title": "Manipur \u0096 Handicrafts - Cane and Bamboo",
            "name": "Manipur \u0096 Handicrafts - Cane and Bamboo",
            "desc": "Bamboo, is abundantly grown in Churachandpur, Jiribam, Tamenglong and Imphal districts of Manipur. Manipur is the largest producer of bamboo products after Tripura in the entire north-east region. Some of the bamboo products are sofa sets, mats, basketry, tray, chair, table, flower vase, ashtray and other decorative and utility articles.",
            "img": "/state-images/Manipur/bambbo-3.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "ww0sh57t4",
            "title": "Manipur- Handicrafts - Stone Carving",
            "name": "Manipur- Handicrafts - Stone Carving",
            "desc": "Stone carving is a traditional craft of Manipur. In Bishnupur district utility items like bowls, candle-stands, grinders, flower-vases, stone glasses, plates, etc. are made. In Manipur there is a custom of constructing an engraved memorial stone for their deceased describing their achievements and good deeds on the outskirts of the village. So making stone carving was popular even from earlier days.",
            "img": "",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "hs96ii7f5",
            "title": "Manipur- Handicrafts - Kauna (Water Reed) Crafts",
            "name": "Manipur- Handicrafts - Kauna (Water Reed) Crafts",
            "desc": "Imphal valley of Manipur is the centre for kauna crafts. This is often used for making mats, chairs, cushion, coasters, bags, moorah (low stools) etc. A unique craft of Manipur is the double-weave mat known as the kaunaphak reed mat. Known as phak in Meithei, a language of Manipur, the reed used to weave the mat is called kauna. The mat is made by the local people for their own use, as well as for commercial purposes. Phak is yellow in colour and is the succulent stem of a plant that grows in water. Reeds are carefully chosen for the mats. The plant is cut only when it has reached maturity. Once cut, the stems are dried and become soft and quite brittle. A bunch of cut stems of the appropriate length are then woven with bamboo placed at suitable distance to give the mat its desired length. The border has an interesting pattern and is about an inch wide. The kauna reed mats are not meant to be washed as the reed gets spoilt with moisture.",
            "img": "/state-images/Manipur/Kauna-Arm-Chair-jpg.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "ofafbt60u",
            "title": "Textile Weaving",
            "name": "Textile Weaving",
            "desc": "Textile weaving is a house hold industry in Manipur. Coarse cotton cloth and silk is woven on the looms. Cotton thread is imported in large quantities. Cotton yarn is dyed with red, yellow, green, orange, black and pink colours. Artistic designs are arranged horizontally and vertically by producing stripes and geometrical blocks. These blocks are filled up with geometrical designs of smaller components. The rhythm of colour bands is maintained. This craft is also known by the name of Laichamphi which means cotton cloth. However, loin loom weaving caters to the local demands and requirements only.",
            "img": "/state-images/Manipur/weaving.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "j8rbhvcf5",
            "title": "Manipur- Handicrafts - Dolls and Toys",
            "name": "Manipur- Handicrafts - Dolls and Toys",
            "desc": "In Manipur dolls and toys are made from different materials like cloth, cotton, clay, wood and bamboo etc. They have a charm of their own with their traditional outfits. Dolls include characters like Radha Krishna, and toys include stylized animals and birds forms.",
            "img": "/state-images/Manipur/dolls.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
