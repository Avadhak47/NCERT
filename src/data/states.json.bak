      "museums": [
        {
          "id": "49zsxk5vx",
          "title": "Nalanda Museum",
          "name": "Nalanda Museum",
          "desc": "The museum established in 1971 has a small but beautiful collection of Buddhist and Hindu bronzes and a good collection of ancient manuscripts and Buddhist statues. The manuscripts kept here were found during the excavation of the area and many of them are rare in appearance and style. The museum also displays artifacts of the Maurya, Gupta and other periods. Two enormous terracotta jars of the first century stand intact behind the museum in a shade. The collection includes copper plates and stone inscriptions, coins, pottery and samples of burnt rice (twelfth century CE) found among the ruins here.",
          "img": "/state-images/Bihar/NalandaMuseum.webp",
          "historical_significance": "Modern 1947-1980",
          "materials": ""
        },
        {
          "id": "q1dhbfukw",
          "title": "Patna Museum",
          "name": "Patna Museum",
          "desc": "Established in 1917, Patna Museum has an excellent collection of stone and terracotta sculptures especially from the Mauryan period. Didarganj Yakshi,carved out of a yellowish sand stone, is the most noteworthy piece in the museum. The sculpture is over 2,000 years old, having a lustrous finish. Mother goddess figures, clay toy animals, figurines of women, couples and deities, Chinese paintings, Thangkas and early Buddhist figures, including a standing Buddha and Bodhisattvas, made of bronzes are the other artifacts on display. Keywords-Patna Museum, Didarganj Yakshi, Mother Goddess, Thangkas.",
          "img": "/state-images/Bihar/PatnaMuseum.webp",
          "historical_significance": "Modern 1900-1947",
          "materials": ""
        },
        {
          "id": "2466ed3a",
          "title": "Patna Museum-  terracotta sculptures (Didarganj Yakshi)",
          "name": "Patna Museum-  terracotta sculptures (Didarganj Yakshi)",
