      "fairs_and_festivals": [
        {
          "id": "mp1s1nhfr",
          "title": "Wangala Festival",
          "name": "Wangala Festival",
          "desc": "Among the Garos, the most important festival is the Wangala or the hundred-drum festival. A harvest festival celebrated in honour of Saljong, the Sun-God of fertility it marks the end of the hard work in the fields, bringing a good yield of crops. The men beat the drums and move forward in rhythmic union. Doregata dance is another interesting dance. In this dance, women try to knock off the turbans of their male partners, using their heads. The Khasis have two important festivals - Nongkrem and Shad-Suk Mynsiem. Nongkrem dance festival, held for five days is a religious",
          "img": "/state-images/Meghalaya/wangala-dance-meghalaya.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        }
      ],
      "museums": [
        {
          "id": "abazpntp2",
          "title": "Museum- Megalaya- The State Museum of Meghalaya",
          "name": "Museum- Megalaya- The State Museum of Meghalaya",
          "desc": "Located in Shillong, Meghalaya State Museum, also known as Williamson Sangma State Museum is a store house of ethnic art and culture, with an array of artifacts including replicas of Ashoka pillar, utensils, weapons, pottery, ornaments, traditional cutting tools and musical instruments. The museum has a habitat section tribes, instruments used for hunting, fishing appliances, weapons, agricultural implements, transport equipments, domestic articles like pots, spoons, water jugs, tobacco boxes, baskets etc.",
          "img": "",
          "historical_significance": "Contemporary",
          "materials": ""
