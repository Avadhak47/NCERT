        "performing_arts": [
          {
            "id": "ob4v8npjq",
            "title": "Rajasthan- Performing Art- Dance- Bhavai",
            "name": "Rajasthan- Performing Art- Dance- Bhavai",
            "desc": "One of the state's most spectacular performances, Bhavai consists of veiled women dancers balancing up to seven or nine brass pots and their heads as they dance swaying on their soles perched on the top of a glass or on the edge of the sword.",
            "img": "/state-images/Rajasthan/bhavai-1.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "4hhqx8auw",
            "title": "Rajasthan- Performing Art- Dance- Ghoomar",
            "name": "Rajasthan- Performing Art- Dance- Ghoomar",
            "desc": "A community dance of the Rajputs, performed by the women of the house and traditionally out of bounds for the men, Ghoomar uses simply, swaying movements to convey the spirit of any auspicious occasion. There is, however, an amazing grace as the skirts flair slowly while the women twirl in circles, their faces covered by the veil. All women, young or old, participate in Ghoomar dance, which can continue for hours into the night. As one of the traditional rituals, a bride is expected to dance Ghoomar on being welcomed to her husband's home.",
            "img": "/state-images/Rajasthan/ghoomar-dance.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "q9ydxqqbx",
            "title": "Rajasthan- Performing Art- Dance-Terahtaali",
            "name": "Rajasthan- Performing Art- Dance-Terahtaali",
            "desc": "A devotional form of dance practiced by the Kamad community, to honor their folk hero Baba Ramdev, it consists of women sitting on the floor before his image. Tied to various parts of their body are thirteen cymbals, which they strike with the ones they hold in their hand. Their hands perform various arabesques while they do this and for effect, they may also balance pots on their hands and hold a sword in their mouth.",
            "img": "",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "4obaj5i58",
            "title": "Rajasthan- Performing Art- Music- Jaipur - Atrauli Gharana",
            "name": "Rajasthan- Performing Art- Music- Jaipur - Atrauli Gharana",
            "desc": "The most distinctive feature of the Jaipur Gharana can be best described as its complex and melodic form which arises out of the involutedly and undulating phrases that comprise the piece. Founders - Ustad Alladiya Khan Exponents - Alladiya Khan, Mallikarjun Mansur, Kesarbhai Kerkar, Kishori Amonkar, Shruti Sadolikar, Padma Talwalkar and Ashwini Bhide Deshpande. The mixture and brilliance of Rajasthan's architectural heritage in the form of majestic forts, intricately carved temples and havelis (mansion), forts, step wells, the vibrant and colourful traditions make Rajasthan a paradise for tourists, historians and scholars. This vibrant and striking region is the home of the Rajput warriors who had ruled here for many years. The Rajputs were prolific builders and have dotted the arid Aravali landscape with their legacy of some most imposing and magnificent forts and palaces in the world. Today the structures tell the story of gallantry, courage and tragedy of the bygone era.",
            "img": "/state-images/Rajasthan/padma-talwalkar-jaipur-gharana.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
