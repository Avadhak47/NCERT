        "performing_arts": [
          {
            "id": "7c1txtmly",
            "title": "Ruf Dance",
            "name": "Ruf Dance",
            "desc": "The Ruf Dance is a part of Kashmiri life from time immemorial. The dance has been a part of Kashmiri life from ancient times. This dance is performed to welcome the spring. In the dance, two or four groups are formed consisting of 2 to 3 women. They stand facing each other holding hands of their partner. The women together sway their feet forward and backward. The song sung in the performance is in the form of question and answer form where one group questions and the other respond to it in rhythm.",
            "img": "/state-images/Jammu_Kashmir/ruf-dance.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "zjttp4bqc",
            "title": "Jammu & Kashmir- Performing Arts- Dance- Hafiza",
            "name": "Jammu & Kashmir- Performing Arts- Dance- Hafiza",
            "desc": "The Hafiza dance form is very popular. This dance form is usually performed at wedding ceremonies. Hafiz Nagma is based on the classical music of Kashmir- the Sufiyiana Kalam. The Sufiyana Kalam has its own ragas known as Muquam. The prominent instrument used in Hafiz Nagma is called Santoor-a hundred stringed instrument played with sticks. The danseuse in this tradition is known as 'Hafiza'.",
            "img": "",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "32h094inu",
            "title": "Jammu & Kashmir- Performing Arts- Musical Instruments",
            "name": "Jammu & Kashmir- Performing Arts- Musical Instruments",
            "desc": "The most popular Kashmiri musical instruments are the santoor, rabab, dukra, sitar and nagara.",
