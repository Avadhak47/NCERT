      "fairs_and_festivals": [
        {
          "id": "o801fd1g6",
          "title": "Fairs and Festivals",
          "name": "Fairs and Festivals",
          "desc": "The various festivals of Manipur are Ningol Chakouba, Yaoshang (Holi), Ramzan Id, Kut, Gan-ngai, Chumpha, Christmas, Cheiraoba, Kang and Heikru Hitongba. Most of these festivals are usually celebrated according to the lunar calendar.",
          "img": "/state-images/Manipur/manipur-festival.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "pdzbccf18",
          "title": "Manipur- Fairs and Festivals - Ningol Chakouba",
          "name": "Manipur- Fairs and Festivals - Ningol Chakouba",
          "desc": "This is a social festival of the Meiteis (the Vaishnavites) where the women (Ningol) are invited to a feast at their parental house along with their children. It is the festival that binds and revives the family relations between the girls married away and the parents.",
          "img": "/state-images/Manipur/manipur-festival-1.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "t8hbeqv0v",
          "title": "Manipur- Fairs and Festivals \u0096 Yaoshang",
          "name": "Manipur- Fairs and Festivals \u0096 Yaoshang",
          "desc": "Celebrated for five days starting from the full moon of Phalguna, in the month of March, Yaoshang is a festival like Holi, a riot of colours and water. There is chanting of hymns/slokas by the devotees of Lord Krishna. Another feature of this premiere festival is the Thabal Chongba (Dancing in the Moonlight). The boys from various places come to the site of the festival and dance with the girls by holding on to their hands and moving in circles.",
          "img": "/state-images/Manipur/manipuri-dance.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
