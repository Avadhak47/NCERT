        "dance_forms": {
          "folk": [
            {
              "id": "931bda41",
              "name": "Raut Nacha\n\nYadava & tribal groups",
              "desc": "Performed by shepherd community celebrating Krishna & harvest. Raut dance is a traditional dance of the Yadav community which is performed on Deepawali. In this dance, the Rauts, wearing a special costume, sing and dance in group with stick in their hands in the pathways of the village. After the performance of dance in the house of every householder, they gives blessings to every household by singing songs of blessings. \u2018Timki\u2019, \u2018Mohri\u2019, \u2018Dafda\u2019, \u2018Dholak\u2019, \u2018Singabaja\u2019 etc. are the main instruments of this dance. \u2018Dhohas\u2019 are sung in between the dance. These \u2018Dhohas\u2019 are filled with devotion, policy, humor and mythological references. Men are mainly involved in Raut dance but children also eagerly follow them.",
              "img": "/downloaded_images/5b79c3ef771e782b2f7bb849e5c3e83a.webp",
              "artists": ""
            }
          ],
          "classical": []
        }
