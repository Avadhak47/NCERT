        "dance_forms": {
          "folk": [
            {
              "id": "768a3e31",
              "name": "Bihu",
              "desc": "Celebrates Assamese New Year & spring harvest.\n\n the Bihu festivals are the most important one and is celebrated by all the Assamese people no matter what their caste, creed, religion and faith might be. Spring festival or Rangali celebrated in the middle of March marks the beginning of agricultural season. The Bhogali or the harvesting festival which is celebrated during January is characterized by a community feast, buffalo fight and other such entertainment. Lastly, the Kangali is another version of the festival celebrated in the middle of October marking the completion of sowing and transplanting of paddies. The festivals are characterized by songs and dance by groups of performers and observed with joy and gaiety. The performers have traditional dresses like the Dhoti, Gamccha, and Mekhala Chadar. Hips swayings, brisk steps, flinging and flipping of hands are used. \n\n(Ref: NCERT Textbook fekr1, Ch. 14)",
              "img": "/state-images/Assam/bihu-dance-of-assam.webp",
              "artists": ""
            }
          ],
          "classical": [
            {
              "id": "838d8911",
              "name": "Sattriya",
              "desc": "Sattriya comes from Assam and was first performed in monasteries called sattras. It combines strong and gentle movements, and tells stories through realistic actions, like eating, fighting or showing love. Dancers use their upper body for expression and the lower body for rhythm. It was originally performed by male monks called bhokots, but was later opened to women and the general public. The dance includes group patterns like sarpa and performances, such as the sutradhari dance and gopir nach. Dancers train in sixty-four basic exercises called mati-akhora. Costumes are made from Assamese silk called pat, with traditional local designs and ornaments often with a dhoti or skirt, similar to what monks used to wear. There are two main postures\u2014purusha (male) and prakriti (female). (Ref: NCERT Textbook fekr1, Ch. 13) The 64 rituals are performed through ritualistic dance in the Sattaras of Assam.",
              "img": "/downloaded_images/b560285cc9fdcbd00a073d21846b8441.webp",
              "images": [
                "/downloaded_images/b560285cc9fdcbd00a073d21846b8441.webp",
                "/downloaded_images/8bc5d157bcd1a3e5339fc61823f69a52.webp",
                "/downloaded_images/e3a071c148774715f4cbecd17b605550.webp",
                "/downloaded_images/b9a3b05c20292b827aea14147cbb37a3.webp",
                "/downloaded_images/06878efff4ae7296f2a90e0e4aa34f67.webp",
                "/downloaded_images/df73b6225c0fdfb7b09dd73aba6c84e7.webp",
                "/downloaded_images/0a8c25c9a67d3c7d257143a2845f8ae9.webp"
              ],
              "artists": "1. Jatin Goswami (Padma Bhushan (2025)\n\n\n\n\n2. Haricharan Saika (Padam Shri 2026)\n\n\n\n3. 2.Rasheswar Saikia",
              "artists_images": [
                "/downloaded_images/54023a034fa760664d7ee9449b30cfbc.webp",
                "/downloaded_images/5e71e77f0200f6b02252fe1d7e7e7c59.webp",
                "/downloaded_images/495416a231afe51598b1f836f0c0338e.webp",
                "/downloaded_images/32c9130410af4faa4949802a42194fa7.webp",
                "/downloaded_images/98a975f6fa505615ab5b2e7846bd0b3f.webp"
              ],
              "single_gestures": "",
              "single_gestures_images": [],
              "joint_gestures": "",
              "joint_gestures_images": [],
              "navrasas": "",
              "navrasas_images": []
            }
          ]
        }
      },
      "monuments": [
        {
          "id": "j9eqrh5qo",
          "title": "Kamakhya Temple",
          "name": "Kamakhya Temple",
          "desc": ", situated in Guwahati on the Nilachal hill, is the important temple of the goddess Kali. The temples in the complex are dedicated to different forms of the mother goddess and it is an important pilgrimage. It represents the distinctive Assamese style of architecture. It is said that the female genitalia (yoni) of Lord Shiva\u0092s Sati fell to the ground while he was carrying her corpse. At that instance the hill turned blue and came to be known as Nilachal (blue mountain). The temple has a beehive-like shikhara with delightful sculptured panels and images of Ganesha and other Hindu gods and goddesses on the outside. The sanctum does not have an image but a spring of water.",
          "img": "/state-images/Assam/kamakhya_temple.webp",
          "historical_significance": "",
          "materials": "",
          "lat": 26.165107,
          "lon": 91.7059298
        },
        {
          "id": "bjbdyxxi8",
          "title": "Madan Kamdev Temple",
          "name": "Madan Kamdev Temple",
          "desc": "Famous for its impressive archaeological ruins and stone sculptures, Madan Kamdev has a sculpture of Lord Shiva and the goddess Uma dating back to the Pallava dynasty (eleventh-twelfth centuries). Archaeologists also found evidence of tanks for water storage and fortifications at the site. All this shows that Madan Kamdev must have been an important town in ancient times. The wall, pillars, lintels and door frames of the temple are decorated with floral motifs, images and icons of griffins, nymphs, dancing apsaras, six headed Bhairava, four headed Shiva, women and animals in various postures.",
          "img": "/state-images/Assam/madan-kamdev-temple.webp",
          "historical_significance": "",
          "materials": "",
          "lat": 25.913793540546564,
          "lon": 92.67216000736663
        },
        {
          "id": "z027aktm2",
          "title": "Assam \u0096 Monument- Sibsagar",
          "name": "Assam \u0096 Monument- Sibsagar",
          "desc": "Sibsagar, a historical city was the capital of the mighty Ahoms, who ruled Assam for more than six hundred years before the advent of the British. The most remarkable landmark of the town is the 200 year old Sibsagar tank. On its banks are three significant temples - Shivadol, Vishnudol and Devidol which were all built by Queen Madambika, wife of Siva Singha. The Shivadol is believed to be the highest Siva Temple in India, having a height of 104 feet and the perimeter of 195 feet. The temple belongs to the dvaikuta class in Indian temple architecture and consists of two cells \u0096 a garbhagriha (sanctum sanctorum) and a mandapa (pillared hall). The majestic shikhara (dome) with fluted vertical lines rises over the garbhagriha. Vishnudol dedicated to Lord Vishnu, has a Shiva lingam in the sanctum sanctorum, which is quite unique.",
          "img": "/state-images/Assam/sibsagar.webp",
          "historical_significance": "1200-1750",
          "materials": "",
          "lat": 26.9834936,
          "lon": 94.6394226
        },
