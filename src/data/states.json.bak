      "fairs_and_festivals": [
        {
          "id": "2uvajartj",
          "title": "Uttar Pradesh- Fairs & Festivals- Kumbh",
          "name": "Uttar Pradesh- Fairs & Festivals- Kumbh",
          "desc": "Every year in the month of January and February, this ancient city vibrates when thousands of devotees from all over the world come for the holy dip at Sangam \u0096 called Kumbh. Every 12 years there is Maha Kumbh and every 6 years Ardh Kumbh takes place.",
          "img": "/state-images/Uttar_Pradesh/maha-kumbh.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "9g4sxg09q",
          "title": "Uttar Pradesh- Fairs & Festivals- Magh Mela",
          "name": "Uttar Pradesh- Fairs & Festivals- Magh Mela",
          "desc": "The Magh Mela is held annually, in January and February that lasts for 15 days. The Mela (fair), according to the mythology commemorates the struggle between Gods and demons over a kumbh (pot) of amrit, the elixir of life. When the amrit surfaced from the bottom of the ocean, Lord Vishnu, Preserver of the Universe ran away with the pot of amrit. While he was running, four drops of the elixir fell on the sites that are now the holy towns of Allahabad, Haridwar, Nasik and Ujjain.",
          "img": "",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "x48pihgst",
          "title": "Uttar Pradesh- Fairs & Festivals- Holi/ Janamashtami",
          "name": "Uttar Pradesh- Fairs & Festivals- Holi/ Janamashtami",
          "desc": "Holi and Janamashtami are two festivals celebrated with great fervour in Mathura. Both these festivals are associated with Lord Krishna and in Holi, festivities start by offering colours to the Lord at the temples before it is celebrated on the streets. Artists from various parts of the country gather here to perform raas leela, or divine dance recitals of Krishna\u0092s by devotees. Gayan mandalis, or singing troupes that render folk songs particularly associated with Holi, flock to this place. Janamashtami too is celebrated on the day when Krishna was born. Idols of Krishna and Radha are decorated beautifully and then worshipped.",
          "img": "/state-images/Uttar_Pradesh/janamashtami.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "ib9w17rky",
          "title": "Uttar Pradesh- Fairs & Festivals- Ganga Dusshera",
          "name": "Uttar Pradesh- Fairs & Festivals- Ganga Dusshera",
          "desc": "Ganga has been considered by Hindus as a holy river for time immemorable and being worshipped. Various pilgrimages are situated along this river, which are the hubs of fairs, festivities and worship by millions of Hindus every year. Ten days in the month of Jyeshtha (June) Ganga Dussehra is celebrated at Rishikesh, Haridwar, Garhmukteshwar, Prayag and Varanasi. Devotees take a holy dip in the Ganga, worship it, collect the clay from the banks/ ghats and take it home. Thousands of lamps are floated into the Ganga after aarti at the dusk. Lucknow, the capital of Uttar Pradesh situated along the banks of the river Gomti, rose to prominence as the centre of the Nawabs of Avadh. Historically reputed as a city of culture, it is famous for its gharana of music, Kathak dance and chikankari work (shadow work embroidery) and the huge mausoleums of thenawabs, and the ruins of the Residency stand witness to one of the most remarkable episodes in the Revolt of 1857. During Akbar\u0092s reign (1556-1605), Oudh, as Lucknow was then called, flourished under imperial patronage. In early eighteenth century, the Mughal Emperor Muhammad Shah, appointed Nawab Sadat Khan Burhan-ul-Mulk as the Governor of Oudh beginning the reign of the Nawabs over Oudh, which continued till the close of the eighteenth Century. It was under Asaf-ud-Daulah, the fourth Nawab that Lucknow prospered and grew into a sophisticated and picturesque city with palaces, gardens and imposing architectural monuments. The Nawab\u0092s patronage of music and arts attracted poets, artists, and musicians to Lucknow in large numbers. During these eventful years, Lucknow became one of the most celebrated centers of opulence, dance, poetry and scholarship.",
          "img": "/state-images/Uttar_Pradesh/ganga-dusshehra.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "cd45321f",
          "title": "Kumbh",
          "name": "Kumbh",
          "desc": "Kumbh",
          "img": ""
