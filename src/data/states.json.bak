        "dance_forms": {
          "folk": [
            {
              "id": "211a799c",
              "name": "Bardo Chham\n\nMonpa TRIBE",
              "desc": "Performed during festivals; reflects Buddhist themes of good vs evil. The Bardo Chham is a traditional dance drama of Monpa and Shertukpen communities of Arunachal Pradesh. The theme of the dance revolves around the dramatic victory of good over evil, a popular core concept of many folk performances. Dancers wearing colorful masks perform this dance indicating that the activities of living beings are watched by the gods who reward the good and punish the evil forces.",
              "img": "/downloaded_images/bd0175fddfc07e9bbf791707f7888f8d.webp",
              "artists": ""
            }
          ],
          "classical": []
        }
      },
      "monuments": [
        {
          "id": "w01vhvskg",
          "title": "Arunachal Pradesh- Monument- Malinithan and Bismaknagar",
          "name": "Arunachal Pradesh- Monument- Malinithan and Bismaknagar",
          "desc": "Malinithan and Bismaknagar are important archeological sites in Arunachal Pradesh. Malinithan has many granite images of Hindu gods and goddesses. Bismaknagar is situated at the foot of Mishmi Hills in Lohit district. It has a ruined fort that dates back to the period of the Mahabharata. There are also the",
          "img": "/state-images/Arunachal_Pradesh/Malinithan.webp",
          "historical_significance": "",
          "materials": "",
          "lat": 27.716001386016742,
          "lon": 93.92872416906094
        },
        {
          "id": "p23mk5f8c",
          "title": "Arunachal Pradesh- Monument- Itanagar",
          "name": "Arunachal Pradesh- Monument- Itanagar",
          "desc": "Itanagar is known to have been built on the ruins of Mayapur, a city that once served as the capital of the eleventh century Jitri dynasty. The rulers of this dynasty built many forts, the most important one being the Ita Fort. Constructed by King Ramchandra, it is the most striking architectural remain of the ancient town. There is a yellow-roofed Buddhist Temple at a hilltop in the town. It is surrounded by beautiful gardens that provide a panoramic view of the temple.",
          "img": "https://images.wakelet.com/resize?id=b9a6909b-ab0d-4e20-9d6b-04d51e3b175d&w=1600&h=actual&q=85",
          "historical_significance": "1000-1200",
          "materials": "",
          "lat": 27.0979659,
          "lon": 93.6237291
        },
        {
