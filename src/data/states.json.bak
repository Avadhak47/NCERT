      "monuments": [
        {
          "id": "ng2j7trh9",
          "title": "Shree Govindajee Temple",
          "name": "Shree Govindajee Temple",
          "desc": "It is a simple and beautiful structure with gold domes, a paved court and a large, raised congregation hall. The presiding deity in the centre is flanked by idols of Radha Govinda, Balaram and Krishna on one side and Jagannath, Balabhadra and Subhadra on",
          "img": "/state-images/Manipur/govindaji.webp",
          "historical_significance": "",
          "materials": "",
          "lat": 24.7978796,
          "lon": 93.9484723
        },
        {
          "id": "0o897u7ew",
          "title": "Manipur- Monument - Bishnupur",
          "name": "Manipur- Monument - Bishnupur",
          "desc": "Bishnupur lies at the foot of a hill and is renowned for the fifteenth century Vishnu temple. This temple built of peculiar small bricks, during the reign of King Kiyamba is of historical importance. It is a single-celled, conical roofed temple. Built in 1467, King",
          "img": "/state-images/Manipur/bishnupur.webp",
          "historical_significance": "1400-1500",
          "materials": "",
          "lat": 24.6267287,
          "lon": 93.7600454
        },
