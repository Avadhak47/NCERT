      "fairs_and_festivals": [
        {
          "id": "btobt4kjh",
          "title": "Mizoram- Fairs and Festivals",
          "name": "Mizoram- Fairs and Festivals",
          "desc": "The festivals of Mizoram are related to the agricultural activities that bring forth the vibrancy and the liveliness of the people of Mizoram. Some of the major festivals in Mizoram which can be mentioned are Chapchar Kut, Mim Kut, Pawl Kut and Thalfavang Kut.",
          "img": "/state-images/Mizoram/Mizo_ladies31.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "g0bisau1l",
          "title": "Mizoram- Fairs and Festivals- Chapchar Kut",
          "name": "Mizoram- Fairs and Festivals- Chapchar Kut",
          "desc": "Chapchar Kut, the spring festival is the most important in Mizoram. People of all ages, men and women, dress themselves in traditional and colourful costumes and wear exotic headgears and jewellery. They assemble and perform various folk dances and also sing traditional songs accompanied by beating of drums, gongs and cymbals. The groups from every region come to the event and display their best performance. The performers dance in joyous celebration of life. Cheraw or the bamboo dance which is popular all over the country is also performed during this festival. The Mizo dances are associated with their respective festival celebrations. More popular dances like the Cheraw are performed almost in every festival of the state.",
          "img": "/state-images/Mizoram/chapchar-kut.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "wp20wadvg",
          "title": "Mizoram- Fairs and Festivals- Thalfavang Kut",
          "name": "Mizoram- Fairs and Festivals- Thalfavang Kut",
          "desc": "When the farmers complete the process of weeding of the field and prepare for the forthcoming harvest, the Thalfavang Kut festival takes place. This colourful festival gives the community an opportunity to come together, retain the present bonds and renew the old ones.",
          "img": "/state-images/Mizoram/thalfavang-kut.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "8malw7l8l",
          "title": "Mizoram- Fairs and Festivals- Christmas",
          "name": "Mizoram- Fairs and Festivals- Christmas",
          "desc": "Christmas is celebrated for three days from twenty fourth to tweny sixth December every year. The majority of the population in Mizoram follows Christianity. On Christmas Eve, the people start celebration in their homes and on Christmas, a grand celebration takes place in the church. Next day the people have a grand and sumptuous feast where everyone from young to old take part and rejoice with great fervour and festivities.",
          "img": "",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "86f4fe71",
          "title": "Mim Kut,",
          "name": "Mim Kut,",
          "desc": "Mim Kut,",
          "img": ""
