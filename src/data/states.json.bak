      "fairs_and_festivals": [
        {
          "id": "ojwggwzar",
          "title": "Festival",
          "name": "Festival",
          "desc": "s play an essential role in the socio-cultural life of the people. They are essentially connected with agriculture and celebrated with ritualistic gaiety to thank God or to pray for a bumper harvest. Some of the important festivals are Mopin of Galos, Solung of Adis, Lossar of Monpas, Dree of Apatanis, Si-Donyi of Tagins, Nyokum of Nyishis, Reh of Idu Mishmis etc. Animal sacrifice is a common ritual in most festivals. The 'Solung' is the main festival of Adis. It is celebrated to reap a rich harvest after sowing of seeds and transplantation of paddy plants, to raise more animals and also to be free from natural and other calamities and the prosperity of men. There is singing, dancing and animal sacrifices in this five-day festival. 1600-1650 Medieval Tawang Monastery or Gompa is a 400 year old monastery of the Mahayana sect of the Buddhists. Built in the seventeenth century, at a height of 10,000 ft the monastery was founded by a monk called Mera Lama. It is an enormous complex of 65 buildings - a treasure house of old scriptures, priceless images, painted tapestries, books and collection of gold lettered Buddhist scriptures. The Parkhang hall of the monastery houses the library which holds the rare hand written and block-printed Thangkas or manuscripts of revered books like Tangym, Kangyur and Sungbhum. The other rare works of Buddhist literature include 108 gold-embossed manuscripts of the Teaching of Lord Buddha and 225 volumes of the explanations of Buddha\u0092s teachings covered with specially designed moth - proof silk adorned with paintings. There is a towering eighteen feet high gilded statue of the Buddha in the monastery complex. Besides the monastery the town promotes the small-scale industries and local handicrafts at their Handicrafts Centre, which has a fine range of woollen carpets and shawls amongst other crafts. The Tawang Monastery is associated with the famous Torgva festival which is held in the eleventh Monpa month called the Dawa Chukchipah",
          "img": "/state-images/Arunachal_Pradesh/arunachalfestival-reh.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "87d3013f",
          "title": "Lossar Festival",
          "name": "Lossar Festival",
          "desc": "Lossar Festival",
          "img": "/state-images-new/Arunachal_Pradesh/5ec012f98b549095093296672a9a8c4e.jpg"
        }
      ],
      "museums": [
        {
          "id": "6w3mxjmco",
          "title": "Arunachal Pradesh \u0096 Museum - Jawaharlal Nehru Museum",
          "name": "Arunachal Pradesh \u0096 Museum - Jawaharlal Nehru Museum",
          "desc": "Itanagar has the Jawaharlal Nehru Museum which displays extensive collection of local tribal art including wood carvings, musical instruments, textiles, handicrafts and archeological finds. One can understand the socio-cultural heritage and lifestyle of the people of Arunachal Pradesh from the displayed objects in the museum.",
          "img": "https://upload.wikimedia.org/wikipedia/commons/5/56/Jawaharlal_Nehru_Museum.JPG",
