        {
          "id": "b9426274",
          "title": "Uttarakhand (Ref: NCERT Textbook gekr1, Ch. 10)",
          "name": "Uttarakhand (Ref: NCERT Textbook gekr1, Ch. 10)",
          "desc": "Uttarakhand (Ref: NCERT Textbook gekr1, Ch. 10)",
