      "museums": [
        {
          "id": "7xdb4f86c",
          "title": "Costumes, Bhuri Singh Museum",
          "name": "Costumes, Bhuri Singh Museum",
          "desc": "The Bhuri Singh Museum named after Raja Bhuri Singh, has the family collection of exquisite paintings of Kangra and Basholi schools, as well as the history of Chamba. The museum also displays wood carvings and ancient manuscripts. Apart from the paintings, other items on display are the embroidered Chamba rumaals, coins, hill jewellery and costumes- both traditional and royal, arms and armour, musical instruments and various decorative objects.",
          "img": "/state-images/Himachal_Pradesh/bhuri-singh-museum.webp",
          "historical_significance": "1900-1947",
          "materials": ""
        },
        {
          "id": "2a7g8pqd1",
          "title": "Rumaal , V&A Museum Collection",
          "name": "Rumaal , V&A Museum Collection",
          "desc": "The big handkerchiefs called rumals of Chamba are famous and have always been a symbol of love and a good omen. They are presented at festivals and weddings. They are also used for wrapping ceremonious gifts exchanged between the bride and bridegroom\u0092s families during marriages. These rumals are embroidered very attractively. The designs show clear influence of miniature paintings. It is done in running stitch without any gaps in between and space filled so that the same figure appears on both sides of the cloth. Rasamandal, hunting, Nayika Bhed, Shiva family and Mahabharata are popular themes embroidered on the rumal.",
          "img": "/state-images/Himachal_Pradesh/chamba-rumal-bhuri-2.webp",
          "historical_significance": "1750-1800",
          "materials": ""
        },
