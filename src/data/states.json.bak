        "handicrafts": [
          {
            "id": "qru4jrxzv",
            "title": "Uttarakhand- Handicrafts- Metal and tweeds",
            "name": "Uttarakhand- Handicrafts- Metal and tweeds",
            "desc": "In Almora, Tamta mohalla is the hub of unique traditional copperware art of Almora. Coppersmiths are in abundance in Almora and their works are complete pieces of art. In addition to coppersmiths, Almora is also home to weavers. Traditional tweeds and shawls are another product of the local craft in Almora which reflect the artistic brilliance of the local craftsmen.",
            "img": "",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "nwp5cl5jr",
            "title": "Uttarkhand- Handicrafts- Wood Carving",
            "name": "Uttarkhand- Handicrafts- Wood Carving",
            "desc": "The wood carving of the region is breathtaking for its simple beautiful designs. Wooden front doors carved with floral designs, animals and fishes standout for its simple beauty. The carving on one\u0092s front door is supposed to be symbolic of his prosperity. In Garhwal and Kumaon the facade of the upper storeys of the dwelling units are wooden and are artistically carved. Abundant in wood and wood product, the artisans of the region have designed simple and beautiful designs on carvings on doors, windows and ceilings in the houses of the region. These beautifully ornamented doors and windows have motifs, generally of the Gods or Goddesses, add to the richness of the carvings. The craftspersons also do specific latticework to fill in the open space of the windows in order to give a screen like effect.",
            "img": "/state-images/Uttarkhand/Woodwork.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "vn4nty5es",
            "title": "Uttarakhand- Handicrafts- Ornaments",
            "name": "Uttarakhand- Handicrafts- Ornaments",
            "desc": "In every part of Garhwal and Kumaon, traditional goldsmiths make traditional ornaments using motifs and patterns which are thousands of years old. The ornaments come in variety of gold, silver, copper and brass.",
            "img": "/state-images/Uttarkhand/ornaments.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "9fd57086",
            "title": "Pahadi woollen shawls",
            "name": "Pahadi woollen shawls",
            "desc": "Pahadi woollen shawls",
            "img": ""
          }
        ],
