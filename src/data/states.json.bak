        "dance_forms": {
          "folk": [
            {
              "id": "6f7806b8",
              "name": "Rouf\n\n(Ref: NCERT Textbook hekr1, Ch. 11)",
              "desc": "Another famous traditional dance form is Rouf which is found in Kashmir region. This dance form is practiced on festive occasions like Eid and Ramzan days are going. It is performed by group of women standing face to face to each other but the most notable feature of this dance form is the footwork of the dancers. One of the most known dance form in all the regions of Jammu and Kashmir is \u2018Rouf; which is generally pronounced as \u2018ruf\u2019 in villages and as \u2018row\u2019 in cities. It is a dance performed on set of spring season and has always been an integral part of kashmiri people since a very long time. \n\n(Ref: NCERT Textbook fekr1, Ch. 15) Rouf: performed by women in a group. Tumbaknari (a small kettle drum), rabab (a stringed instrument) and harmonium. Kashmiri attire pheran (loose, long robe) with colourful embroidered dress, jewels: earrings, neckless and bangles. Performed during Eid, Baisakhi and Navroz, as well as weddings, harvest celebrations and other social gatherings.",
              "img": "/downloaded_images/39fa15fa4adf2d60fcd58f92b1b7473c.webp",
              "artists": ""
            }
          ]
        }
      },
      "monuments": [
        {
          "id": "qux81ac5m",
          "title": "Jammu & Kashmir- Monument- Harvana Temple",
          "name": "Jammu & Kashmir- Monument- Harvana Temple",
          "desc": "During the sixth century temples were erected in Kashmir by the Karkotaka Dynasty. These are characterized by lofty double pyramidal roofs and trefoiled doorways covered by triangular pyramidal pediments and columns. Facing either east or west, these temples get ample sunlight symbolizing dynamism and life. These temples have a cellular layout and have a pillared courtyard. Ancient stupas and chaityas in different parts of the region testify an early evidence of spread of Buddhism. The fifth century Harvana temple built with moulded terracotta tiles represents a wide range of themes including human forms, flora and fauna.",
          "img": "",
          "historical_significance": "100-600 CE",
          "materials": "",
          "lat": 34.53232873939739,
          "lon": 74.58446217503798
        },
        {
          "id": "t9pl31ae1",
          "title": "Ruins of Sun Temple, Martand",
          "name": "Ruins of Sun Temple, Martand",
          "desc": "Martand temple is dedicated to the Sun God. This eight century example of stone architecture reflects the influence of Gandhara style and local wooden prototypes conforming to the wooden model. The temple has steep sloping roofs.",
          "img": "/state-images/Jammu_Kashmir/J_002.webp",
          "historical_significance": "100-600 CE",
          "materials": "",
          "lat": 33.98654192759079,
          "lon": 74.61959999084193
        },
        {
          "id": "077y8pwcb",
          "title": "Temple at Avantipur",
          "name": "Temple at Avantipur",
          "desc": "The famous Avantipur temples are believed to have been built in honour of lord Shiva by Avantivarman who is believed to have founded the city in the ninth century. The temples, although in ruins, are of great archaeological interest. There are two main temples, one larger and marked",
          "img": "/state-images/Jammu_Kashmir/awantipur-temple.webp",
          "historical_significance": "600-900 CE",
          "materials": "",
          "lat": 33.289928713402254,
          "lon": 76.12824907867349
        },
        {
          "id": "767c784hv",
          "title": "Shankaracharaya Temple",
          "name": "Shankaracharaya Temple",
          "desc": "The temple of Shankaracharya occupies the top of the hill in the southeast of Srinagar where Shankaracharya stayed when he visited Kashmir in the ninth century from Kerala and delivered discourses. Built on a high octagonal plinth and approached by a flight of steps, it has sidewalls that once bore inscriptions and the main surviving shrine consists of a circular cell. A modern ceiling covers the inner sanctum and an inscription in Persian traces its origin to the reign of Emperor Shah Jehan. The original ceiling was dome- shaped and the brick roof is not more than a century old.",
          "img": "/state-images/Jammu_Kashmir/Shankaracharya.webp",
          "historical_significance": "3000-600 BCE",
          "materials": "",
          "lat": 33.85149751647765,
          "lon": 74.70755081950398
        },
        {
          "id": "g1nbtc1yd",
          "title": "Jammu & Kashmir- Monument- Jami Masjid",
          "name": "Jammu & Kashmir- Monument- Jami Masjid",
          "desc": "Jami Masjid is in the heart of the old city of Srinagar, this is the largest mosque in Kashmir. Originally built by Sultan Sikandar in 1400, and extended by his son, Zain-ul- Abidin, it is a typical example of Indo-Saracenic architecture. It is built around a courtyard with 370 wooden pillars and galleries around it.The principal features of the mosque are the four minars and eight wooden columns as support and a tiered roof capped by a spire.",
          "img": "/state-images/Jammu_Kashmir/mosque-jami-masjid.webp",
          "historical_significance": "1400-1450",
          "materials": "",
          "lat": 34.0653718,
          "lon": 74.7798792
        },
        {
          "id": "qvq2d1lkh",
          "title": "Amar Mahal Palace Museum",
          "name": "Amar Mahal Palace Museum",
