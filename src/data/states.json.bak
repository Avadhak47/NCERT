      "monuments": [
        {
          "id": "z95a1yiai",
          "title": "Temple Complex, Jageshwar",
          "name": "Temple Complex, Jageshwar",
          "desc": "Surrounded by dense forests of fur and pine trees right in the middle of the Almora town are the temples of Nanda Devi and Narsingh. 34 kms from Almora is the ancient Shiva temple complex at Jageshwar. This houses one of the 12 jyotirlingas in the country. This temple",
          "img": "/state-images/Uttarkhand/jageshwar.webp",
          "historical_significance": "600-900 CE",
          "materials": "",
          "lat": 30.087255736267945,
          "lon": 77.86218724481327
        },
        {
          "id": "8v6p7w7iw",
          "title": "Baijnath Temple",
          "name": "Baijnath Temple",
          "desc": "Kausani has the famous temple complex of Baijnath in the Garur valley of Katyur. A group of ancient temples dating back to the twelfth and thirteenth century line the banks of the river, presenting a beautiful sight. The temples are famous for its carving stone work. The main 10th century temple houses a beautiful idol of Goddess Parvati chiselled in black stone.According to the local tales Shiva and Parvati are believed to have married at the confluence of the Gomati and Garur Ganga. Innumerable tales of Lord Shiva and Parvati make these temples a fascinating",
          "img": "/state-images/Uttarkhand/Baijnath1.webp",
          "historical_significance": "900-1000",
          "materials": "",
          "lat": 31.211052390811993,
          "lon": 78.7152170236533
        },
        {
          "id": "ww7d0pvck",
          "title": "Kedarnath Temple",
          "name": "Kedarnath Temple",
          "desc": "The temple of Kedarnath is dedicated to Lord Shiva. The temple is built of large, heavy and evenly cut grey stone slabs, and is considered to be more than 1000 years old. It has a garbhagriha where the conical rock formation is situated, and a mandapam for seating devotees.",
          "img": "/state-images/Uttarkhand/Kedarnath.webp",
          "historical_significance": "Early Medieval",
          "materials": "",
          "lat": 30.573220408219697,
          "lon": 77.27917330131748
        },
        {
