      "facts": [],
      "art_forms": {
        "paintings": [
          {
            "id": "0480f5ee",
            "title": "Phulkari-influenced motif (Mainly in Punjab)",
            "name": "Phulkari-influenced motif (Mainly in Punjab)",
            "desc": "Phulkari-influenced motif (Mainly in Punjab)",
            "img": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/1d/Mural_at_Hop_Pocket_Craft_Shops_-_geograph.org.uk_-_1740405.jpg/640px-Mural_at_Hop_Pocket_Craft_Shops_-_geograph.org.uk_-_1740405.jpg"
          }
        ],
        "performing_arts": [
          {
            "id": "9gksdk48b",
            "title": "Haryana- Performing Arts- Music",
            "name": "Haryana- Performing Arts- Music",
            "desc": "Haryana has a rich tradition of music. Even villages have been named after classical ragas. In Dadri tehsil, several villages are named on well known ragas such as Nandyam, Sarangpur, Bilawala, Brindabana, Todi, Asaveri, Jaishri, Malakoshna, Hindola, Bhairavi, Gopi Kalyana etc. Similarly in Jind district there are Jai Jai Vanti, Malavi etc.",
            "img": "/state-images/Haryana/Ha_013.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "yw100klji",
            "title": "Phalgun Dance",
            "name": "Phalgun Dance",
            "desc": "During the month of February \u0096March, Phag Dance or Phalgun Dance is performed with joy and vigour. In this dance-men and women group together and involve themselves in a variety of movements, rhythm requiring sound co-ordination. The word Swang stands for disguise or imitation. It is performed in the old tradition on the \u0091open stage\u0092. It is an all male cultural troupe of twenty to thirty artistes, including the director, producer musicians and actors. The female roles are also played by males. A mutual dialogue between two characters or groups of characters; costumes and music are the main elements of the performance, accompanied by a number of folk instruments like Dholak, Nagara, Tasha, Been, Cymbals etc. Usually performed by villagers, swang is a blend of folklore, music and narration.",
            "img": "/state-images/Haryana/Ha_016.webp",
            "historical_significance": "Contemporary",
            "materials": ""
          },
          {
            "id": "326d8f35",
            "title": "Swang Dance",
            "name": "Swang Dance",
            "desc": "Swang Dance",
            "img": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/1d/Mural_at_Hop_Pocket_Craft_Shops_-_geograph.org.uk_-_1740405.jpg/640px-Mural_at_Hop_Pocket_Craft_Shops_-_geograph.org.uk_-_1740405.jpg"
          },
