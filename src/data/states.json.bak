      "fairs_and_festivals": [
        {
          "id": "5kx1yvxrr",
          "title": "Madai Festival",
          "name": "Madai Festival",
          "desc": "This festival is popularly celebrated by the Maria Gonds of Bastar to meet relatives settled in different villages across the state. The tribal Goddess is honored by offering the sacrifice of a goat beneath the sacred village tree. The nights are marked with merriment like singing, drinking and dancing. Madai of Narayanpur in Bastar is famous.",
          "img": "/state-images/Chhattisgarh/MADAI.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "v6dc9m9zr",
          "title": "Chhattisgarh \u0096 Fairs and Festivals - Dussehra",
          "name": "Chhattisgarh \u0096 Fairs and Festivals - Dussehra",
          "desc": "The most important festival in the region is a ten days celebration of Dusshera. This festival is believed to have been originated in the fifteenth century by the fourth Kakatiya monarch, Maharaj Purushottam Deo. Almost all the inhabitants of the state participate in this festival. They celebrate Dussehra as a congregation of Maoli Devi and all her sisters. Numerous pujaris (priests) bring local deities beautifully embellished with vibrant colored flowers to the Danteshwari Temple on rathas (chariots) in Jagdalpur. This festival has an underlying spirit of participation, cutting across caste and creed, which prevails. The Dussehra rath, is always pulled by Maria and Dhruva people. The construction of the rath is always exclusively done by the Saoras every year. The iron nails used in the construction of the wooden rath are made by Lohars (blacksmiths).The ropes for dragging the rath are prepared and supplied by the member of the Parja tribe. The construction of the rath is supervised by the Dhakada. Before using the rath for the ceremony it is always worshipped by the members of the Khaki caste.",
          "img": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Bastar_Dusshera_Unexplored_Bastar.jpg",
          "historical_significance": "Contemporary",
          "materials": ""
        }
      ],
