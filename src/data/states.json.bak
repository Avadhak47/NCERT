      "fairs_and_festivals": [
        {
          "id": "afw2vs0fj",
          "title": "Punjab- Fairs & Festival- Gurupurab",
          "name": "Punjab- Fairs & Festival- Gurupurab",
          "desc": "Some festivals are held in the Punjab in honour of the Sikh Gurus. These are called Gurupurabs. They are well spread over the year. There are three important Gurupurabs. On the full moon of Kartik \u0096 in November, the birth anniversary of Guru Nanak is celebrated by the devotees with great ardour. Two days earlier a non-stop reading of the Adi Granth is started. At different places religious congregations are held and hymns from the Granth Sahib are chanted. Large processions are taken out through the towns. At night buildings are illuminated. The birth anniversary of Guru Gobind Singh is also celebrated in a similar manner. The third important Gurupurab is the one associated with the martyrdom of Guru Arjun Dev.",
          "img": "/state-images/Punjab/Gurpurab.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "v0vi4ixrc",
          "title": "Lohri Festival",
          "name": "Lohri Festival",
          "desc": "Lohri marks the culmination of winter, and is celebrated in the month of Paush or Magh, a day before Makar Sankranti on thirteenth of January. It is a popular harvest festival of Punjab. People get together in groups around a bonfire and sing and dance.",
          "img": "/state-images/Punjab/lohri.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
          "id": "lcf64djcv",
          "title": "Punjab- Fairs & Festivals- Baisakhi",
          "name": "Punjab- Fairs & Festivals- Baisakhi",
          "desc": "Baisakhi is a seasonal festival celebrated all over the state at the time when harvest is gathered in and the farmer revels in the fulfillment of his year\u0092s hard work. Since this festival is also an expression of prosperity, singing and dancing constitute its most enchanting features.",
          "img": "/state-images/Punjab/baisakhi.webp",
          "historical_significance": "Contemporary",
          "materials": ""
        },
        {
