                "/downloaded_images/761d24ee12d69db3562e8de0413c9862.webp",
                "/downloaded_images/259d54fa66911df8dbd631480e8c690e.webp",
                "/downloaded_images/21eb8c23d4dc855190f0ebcea30baded.webp"
              ],
              "artists": "1. C. V.\nChandrashekhar",
              "artists_images": [
                "/downloaded_images/d996f21620c7dfc6ca796ae831771d07.webp",
                "/downloaded_images/8cf001aa2f3077d045a527b379eb0aa4.webp",
                "/downloaded_images/dee8ade8d7b660c435c57250b1dcca9b.webp",
                "/downloaded_images/7bf21cc55ae41308afc0faa3f89dcc21.webp"
              ],
              "single_gestures": "1. Pataka\n2. Tripataka\n3. Ardhapataka\n4. Kartarimukha\n5. Mayura\n6. Ardhachandra\n7. Arala\n8. Sukhatunda\n9. Mushti\n10. Shikhara\n11. Kapitha\n12. Katakamukha\n13. Suchi \n14. Chandrakala\n15. Padmakosha \n16. Sarpasirsha\n17. Mrigasirsha\n18. Simhamukham\n 19. Kangula \n20. Allapadma\n 21. Chatura\n22. Bhramara\n23. Hamsasya\n24. Hamsapaksha\n 25. Samdamsha\n26. Mukula\n27. Tamrachuda\n28. Trishula",
              "single_gestures_images": [],
              "joint_gestures": "1. Anjali\n2. Kapota\n3. Karkata\n4. Swastika\n5. Dola\n6. Puspaputa\n7. Utsanga\n8. Shivlinga\n9. Katakavardana\n10. Kartariswastika\n11. Shakata\n12. Shanka\n13. Chakra\n14. Samputa\n15. Pasha\n16. Keelaka\n17. Matsya\n18. Kurma\n19. Varaha\n20. Garuda\n21.Nagabandha\n22. Khatwa\n23. Berunda\n24. Avahitta",
              "joint_gestures_images": [
                "/downloaded_images/86febacc731342334182cb7065f6d315.webp",
                "/downloaded_images/7773a41b5ebb674f9727077635318076.webp",
                "/downloaded_images/60dd4072026eac80709d0c4c05cc02e4.webp"
              ],
              "navrasas": "1. The sthayi bhava of Rati (passion of love) gives rise to the Shringara Rasa (erotic).\n2.The sthayi bhava of Haasa (mirth) gives rise to the Hasya Rasa (laughter).\n3.The sthayi bhava of Shoka (sorrow) gives rise to the Karuna Rasa (compassion).\n4.The sthayi bhava of Krodha (anger) gives rise to the Raudra Rasa (fury).\n5.The sthayi bhava of Utsaha (heroism) gives rise to the Veer Rasa (heroic).\n6.The sthayi bhava of Bhaya (fear) gives rise to the Bhayanaka Rasa (fearful).\n7.The sthayi bhava of Jugupsa (disgust) gives rise to the Vibhatsa Rasa (revulsion).\n8.The sthayi bhava of Vismaya (astonishment) gives rise to the Adbhuta Rasa (wonder).\n\n9. Nirveda Bh\u0101va leading to Sh\u0101nta Rasa.",
              "navrasas_images": [
