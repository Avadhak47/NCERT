      "museums": [
        {
          "id": "pq4zzh5ya",
          "title": "Museum's collections",
          "name": "Museum's collections",
          "desc": "Established in 1940, the Assam State Museum is one of the biggest multipurpose museums in the country. With separate sections for archaeology, epigraphy, numismatics and iconography, the collection includes archaeological, wooden and bell-metal objects, ivory, terracotta, pith etc. Painting, old textiles, arms and weapons, ethnographic objects and stone sculptures are the other artifacts on display.",
