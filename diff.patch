@@ -4882,7 +4882,7 @@
             "title": "Langvir dance",
             "name": "Langvir dance",
             "desc": "The performing arts of Uttarkhand like most other locall cultures in India, revolves around rustic music and dance. The colorful tribes and clans have their own indigenous dance forms which they perform with the accompaniment of local",
